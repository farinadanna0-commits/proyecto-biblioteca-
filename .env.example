# Copiar este archivo a ".env" y ajustar los valores.

PORT=5000
JWT_SECRET=cambia-esta-clave-jwt

# Base de datos (Supabase/Postgres) — sacar la cadena real desde
# Supabase > Connect > Direct (usar la del "pooler", no la de "Direct connection")
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:6543/postgres

MULTA_POR_DIA_ATRASO=100
DIAS_PRESTAMO_DEFAULT=14
COSTO_REPOSICION_DEFAULT=5000
