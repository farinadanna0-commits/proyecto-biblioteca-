# Copiar este archivo a ".env" y ajustar los valores.

SECRET_KEY=cambia-esta-clave
JWT_SECRET_KEY=cambia-esta-clave-jwt

# SQLite (desarrollo, por defecto si se omite esta variable):
# DATABASE_URL=sqlite:///instance/biblioteca.db
# PostgreSQL (producción):
# DATABASE_URL=postgresql://usuario:password@localhost:5432/biblioteca_cespa

MULTA_POR_DIA_ATRASO=100
DIAS_PRESTAMO_DEFAULT=14
COSTO_REPOSICION_DEFAULT=5000
